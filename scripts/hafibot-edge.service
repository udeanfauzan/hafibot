[Unit]
Description=Hafibot Jetson Nano Edge Agent
After=network-online.target nvargus-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/hafibot
Environment=PYTHONUNBUFFERED=1

# Restart nvargus-daemon as root before launching agent
PermissionsStartOnly=true
ExecStartPre=-/bin/systemctl restart nvargus-daemon
ExecStartPre=/bin/sleep 2

# Launch edge agent with network wait & speaker volume 1.3
ExecStart=/bin/bash /home/jetson/hafibot/scripts/start_edge_agent.sh http://100.86.76.95:5000

Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
