<launch>
  <!-- Argumen konfigurasi -->
  <arg name="camera_topic" default="/usb_cam/image_raw" />
  <arg name="threshold" default="0.90" />
  <arg name="pose_loss_grace_sec" default="2.0" />
  <arg name="fall_hold_sec" default="5.0" />
  <arg name="pose_reacquire_confirmation_frames" default="3" />
  <!-- Geometric posture verification (gating upright posture to prevent false alarms) -->
  <arg name="enable_posture_filter" default="true" />
  <arg name="min_upright_torso_angle" default="50.0" />
  <arg name="min_upright_aspect_ratio" default="1.25" />
  <arg name="min_dy_torso" default="0.04" />
  <arg name="src_path" default="/workspace/FallDetectionCNN" /> <!-- Ubah path ini sesuai letak source code python asli -->
  <!-- Jetson landmark recording for deployment-matched retraining data -->
  <arg name="recording_dir" default="/workspace/FallDetectionCNN/data/jetson_recordings" />
  <arg name="recording_enabled_on_start" default="false" />
  <arg name="recording_label" default="UNLABELED" />
  <arg name="recording_subject" default="unknown_subject" />
  <arg name="recording_activity" default="unspecified" />
  <arg name="stats_publish_hz" default="1.0" />
  <!-- Audible alarm: ALSA output device may be overridden from Docker .env. -->
  <arg name="alarm_enabled" default="$(optenv HAFIBOT_FALL_ALARM_ENABLED true)" />
  <arg name="alarm_alsa_device" default="$(optenv HAFIBOT_ALSA_DEVICE default)" />
  <arg name="alarm_frequency_hz" default="880.0" />
  <arg name="alarm_beep_duration_sec" default="0.25" />
  <arg name="alarm_beep_count" default="3" />
  <arg name="alarm_gap_sec" default="0.15" />
  <arg name="alarm_volume" default="0.8" />
  <arg name="alarm_cooldown_sec" default="2.0" />

  <!-- Telegram Notifier (DINONAKTIFKAN â€” digantikan Web Push Notification dari Flask)
  <arg name="telegram_bot_token" default="$(optenv TELEGRAM_BOT_TOKEN '')" />
  <arg name="telegram_chat_id" default="$(optenv TELEGRAM_CHAT_ID '')" />
  <arg name="telegram_authorized_ids" default="$(optenv TELEGRAM_AUTHORIZED_IDS '')" />
  <arg name="telegram_cooldown" default="30" />
  <arg name="telegram_auto_delete" default="7200" />
  <arg name="monitor_url" default="$(optenv HAFIBOT_MONITOR_URL '')" />
  -->

  <!-- Node Kamera dinonaktifkan (Digabung ke fall_detection_node untuk optimasi) -->
  <!--
  <node name="camera_node" pkg="fall_detection_ros" type="camera_node.py" output="screen">
    <param name="video_device" value="/dev/video0" />
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
  </node>
  -->

  <!-- Human Following Args (Serial ke Arduino Mega 2560 Pro Mini) -->
  <!-- Safety default: operator explicitly enables following after startup. -->
  <arg name="hf_enabled"        default="false" />
  <arg name="hf_serial_port"    default="/dev/ttyUSB0" />
  <arg name="hf_baudrate"       default="115200" />
  <arg name="hf_send_rate_hz"   default="10.0" />
  <arg name="hf_target_timeout" default="1.0" />
  <arg name="hf_pause_on_fall"  default="true" />
  <!-- Kalibrasi shoulder-to-distance (polyfit orde 2). Format: [A, B, C]
       Hasil kalibrasi: MAE=9.5cm, 8 sample (250-500cm), CSI 640x480 -->
  <arg name="shoulder_polyfit"  default="[0.0942, -18.5704, 1165.8]" />
  <arg name="frame_width"       default="640" />
  <arg name="frame_height"      default="480" />
  <!-- Following-target validation and temporal filtering -->
  <arg name="target_min_shoulder_visibility" default="0.6" />
  <arg name="target_confirmation_frames" default="3" />
  <arg name="target_distance_ema_alpha" default="0.35" />
  <arg name="target_center_ema_alpha" default="0.4" />
  <arg name="target_max_distance_jump_cm" default="90.0" />
  <arg name="target_max_center_jump" default="0.22" />
  <!-- Multi-Joint Torso + Shoulder Fusion for body-invariant following distance -->
  <arg name="enable_torso_fusion"       default="true" />
  <arg name="torso_shoulder_ratio"      default="0.80" />
  <arg name="target_min_hip_visibility" default="0.5" />
  <!-- Native IMX219 mode 2: 1920x1080@30, downscaled and consumed at 15 FPS -->
  <arg name="camera_sensor_id"      default="0" />
  <arg name="camera_sensor_mode"    default="2" />
  <arg name="camera_capture_width"  default="1920" />
  <arg name="camera_capture_height" default="1080" />
  <arg name="camera_capture_fps"    default="30" />
  <arg name="camera_output_fps"     default="15.0" />
  <arg name="stream_jpeg_quality"   default="60" />

  <!-- Node Fall Detection -->
  <node name="fall_detection" pkg="fall_detection_ros" type="fall_detection_node.py" output="screen">
    <param name="camera_topic" value="$(arg camera_topic)" />
    <param name="threshold"    value="$(arg threshold)" />
    <param name="pose_loss_grace_sec" value="$(arg pose_loss_grace_sec)" />
    <param name="fall_hold_sec" value="$(arg fall_hold_sec)" />
    <param name="pose_reacquire_confirmation_frames" value="$(arg pose_reacquire_confirmation_frames)" />
    <param name="enable_posture_filter" value="$(arg enable_posture_filter)" />
    <param name="min_upright_torso_angle" value="$(arg min_upright_torso_angle)" />
    <param name="min_upright_aspect_ratio" value="$(arg min_upright_aspect_ratio)" />
    <param name="min_dy_torso" value="$(arg min_dy_torso)" />
    <param name="src_path"     value="$(arg src_path)" />
    <param name="recording_dir" value="$(arg recording_dir)" />
    <param name="recording_enabled_on_start" value="$(arg recording_enabled_on_start)" />
    <param name="recording_label" value="$(arg recording_label)" />
    <param name="recording_subject" value="$(arg recording_subject)" />
    <param name="recording_activity" value="$(arg recording_activity)" />
    <param name="stats_publish_hz" value="$(arg stats_publish_hz)" />
    <rosparam param="shoulder_polyfit" subst_value="true">$(arg shoulder_polyfit)</rosparam>
    <param name="frame_width"  value="$(arg frame_width)" />
    <param name="frame_height" value="$(arg frame_height)" />
    <param name="target_min_shoulder_visibility" value="$(arg target_min_shoulder_visibility)" />
    <param name="target_confirmation_frames" value="$(arg target_confirmation_frames)" />
    <param name="target_distance_ema_alpha" value="$(arg target_distance_ema_alpha)" />
    <param name="target_center_ema_alpha" value="$(arg target_center_ema_alpha)" />
    <param name="target_max_distance_jump_cm" value="$(arg target_max_distance_jump_cm)" />
    <param name="target_max_center_jump" value="$(arg target_max_center_jump)" />
    <param name="enable_torso_fusion" value="$(arg enable_torso_fusion)" />
    <param name="torso_shoulder_ratio" value="$(arg torso_shoulder_ratio)" />
    <param name="target_min_hip_visibility" value="$(arg target_min_hip_visibility)" />
    <param name="camera_sensor_id" value="$(arg camera_sensor_id)" />
    <param name="camera_sensor_mode" value="$(arg camera_sensor_mode)" />
    <param name="camera_capture_width" value="$(arg camera_capture_width)" />
    <param name="camera_capture_height" value="$(arg camera_capture_height)" />
    <param name="camera_capture_fps" value="$(arg camera_capture_fps)" />
    <param name="camera_output_fps" value="$(arg camera_output_fps)" />
    <param name="stream_jpeg_quality" value="$(arg stream_jpeg_quality)" />
  </node>

  <!-- Non-blocking local alarm; plays once on each False -> True alert edge. -->
  <node name="fall_alarm" pkg="fall_detection_ros" type="fall_alarm_node.py" output="screen">
    <param name="src_path" value="$(arg src_path)" />
    <param name="enabled" value="$(arg alarm_enabled)" />
    <param name="alert_topic" value="/fall_detection/alert" />
    <param name="alsa_device" value="$(arg alarm_alsa_device)" />
    <param name="frequency_hz" value="$(arg alarm_frequency_hz)" />
    <param name="beep_duration_sec" value="$(arg alarm_beep_duration_sec)" />
    <param name="beep_count" value="$(arg alarm_beep_count)" />
    <param name="gap_sec" value="$(arg alarm_gap_sec)" />
    <param name="volume" value="$(arg alarm_volume)" />
    <param name="cooldown_sec" value="$(arg alarm_cooldown_sec)" />
  </node>

  <!-- Node Human Following (bridge ROS <-> Arduino Mega via Serial USB) -->
  <node name="human_following" pkg="fall_detection_ros" type="human_following_node.py" output="screen">
    <param name="src_path"          value="$(arg src_path)" />
    <param name="serial_port"       value="$(arg hf_serial_port)" />
    <param name="baudrate"          value="$(arg hf_baudrate)" />
    <param name="send_rate_hz"      value="$(arg hf_send_rate_hz)" />
    <param name="target_timeout"    value="$(arg hf_target_timeout)" />
    <param name="pause_on_fall"     value="$(arg hf_pause_on_fall)" />
    <param name="enabled_on_start"  value="$(arg hf_enabled)" />
  </node>

  <!-- Node Flask Web Stream + Web Push Notification (PWA) -->
  <node name="flask_stream" pkg="fall_detection_ros" type="flask_stream_node.py" output="screen">
    <param name="src_path" value="$(arg src_path)" />
  </node>

  <!-- Telegram Notifier DINONAKTIFKAN â€” Web Push dari Flask menggantikan fungsinya.
       Untuk mengaktifkan kembali, un-comment block di bawah dan args di atas.
  <node name="telegram_notifier" pkg="fall_detection_ros" type="telegram_notifier_node.py" output="screen">
    <param name="bot_token" type="str" value="$(arg telegram_bot_token)" />
    <param name="chat_id" type="str" value="$(arg telegram_chat_id)" />
    <param name="authorized_ids" type="str" value="$(arg telegram_authorized_ids)" />
    <param name="cooldown_sec" value="$(arg telegram_cooldown)" />
    <param name="auto_delete_sec" value="$(arg telegram_auto_delete)" />
    <param name="monitor_url" type="str" value="$(arg monitor_url)" />
  </node>
  -->

</launch>

