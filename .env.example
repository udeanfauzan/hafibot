# Copy this file to .env and replace every REQUIRED value before deployment.
# Generate the Flask key with: openssl rand -hex 32
FLASK_SECRET_KEY=
HAFIBOT_USERNAME=
# Use at least 12 characters and do not reuse another account password.
HAFIBOT_PASSWORD=

# Keep true when the site is reached through Tailscale Serve or another HTTPS proxy.
# Set false only for short-lived direct-HTTP testing on a trusted local network.
HAFIBOT_SECURE_COOKIES=true
HAFIBOT_SESSION_HOURS=12
HAFIBOT_WEB_THREADS=8

# A fall episode is rearmed only after this many continuous normal seconds.
# This prevents alternating fall/normal predictions from creating duplicates.
HAFIBOT_FALL_CLEAR_DEBOUNCE_SEC=10

# EXPERIMENTAL opt-in only; leave unset for the active legacy model/runtime.
# The file must be a frozen validation-only calibration matching code/weights.
# Recalibrate after runtime code or model changes. Never use unattended before
# continuous ADL + controlled robot trials (including moving-camera tests).
# HAFIBOT_FALL_RUNTIME_CALIBRATION=results/logs/runtime_v2/calibration.json

# Reserve CUDA for real-time pose/fall inference. These large chatbot models
# load only when needed and use CPU by default.
HAFIBOT_QWEN_ENABLED=true
HAFIBOT_QWEN_DEVICE=cpu
HAFIBOT_DBERT_DEVICE=cpu

# Local speaker alarm. Run `aplay -L` on the Jetson/container and replace
# `default` if HDMI or USB audio uses a different ALSA PCM name.
HAFIBOT_FALL_ALARM_ENABLED=true
HAFIBOT_ALSA_DEVICE=default

# Web Push is optional, but the dashboard will report it as unavailable until set.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@example.com
